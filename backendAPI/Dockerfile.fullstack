FROM node:alpine AS frontend-builder
WORKDIR /app
COPY frontend/legopersona/package.json frontend/legopersona/package-lock.json ./
RUN npm install
COPY frontend/legopersona/ .
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ARG VITE_GOOGLE_CLIENT_ID
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
RUN npm run build

FROM node:20-alpine AS backend-builder
WORKDIR /app
COPY backendAPI/backendAPI/package*.json ./
RUN npm install
COPY backendAPI/backendAPI/ .
RUN npm run build

FROM node:20-alpine
WORKDIR /app
COPY --from=backend-builder /app/dist ./dist
COPY --from=backend-builder /app/node_modules ./node_modules
COPY --from=backend-builder /app/elements.csv ./elements.csv
COPY --from=frontend-builder /app/dist ./public
ENV PORT=8001
EXPOSE 8001
CMD ["node", "dist/server.js"]
